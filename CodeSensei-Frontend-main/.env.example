# Base URL of the backend API (defaults to the deployed Render URL if not specified)
REACT_APP_API_URL=https://codesensei-backend.onrender.com

# EmailJS Configuration (optional, replace with your own EmailJS credentials)
REACT_APP_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
REACT_APP_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
REACT_APP_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
